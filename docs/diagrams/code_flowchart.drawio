<mxfile host="SpellWand make_drawio.py"><diagram id="code_flowchart" name="Code flow"><mxGraphModel dx="1240" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="SpellWand: code flow" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=22;fontColor=#1f2430;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="700" height="30" as="geometry"/></mxCell><mxCell id="c4" value="What the wand firmware and the Mac app do, and the BLE_LINK messages between them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#5b6070;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="30" y="54" width="900" height="20" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style='font-size:14px'&gt;Wand firmware (ESP32)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5b6070'&gt;firmware/src/main.cpp + lib/wand_core&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e8eeff;strokeColor=#3d5bd9;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="30" y="92" width="380" height="46" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style='font-size:14px'&gt;BLE_LINK messages&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5b6070'&gt;docs/protocol.md&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fbf3ea;strokeColor=#d9822b;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="430" y="92" width="380" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style='font-size:14px'&gt;Mac app (Python)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#5b6070'&gt;mac_app/: app.py, controller.py, classifier.py, ...&lt;/span&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e6f5ec;strokeColor=#2f8f55;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="830" y="92" width="380" height="46" as="geometry"/></mxCell><mxCell id="c8" value="loop(): runs continuously" style="rounded=1;arcSize=2;dashed=1;fillColor=none;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontStyle=1;fontSize=13.5;strokeColor=#3d5bd9;fontColor=#3d5bd9;" vertex="1" parent="1"><mxGeometry x="30" y="362" width="380" height="600" as="geometry"/></mxCell><mxCell id="c9" value="controller.py: for each message from the wand" style="rounded=1;arcSize=2;dashed=1;fillColor=none;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontStyle=1;fontSize=13.5;strokeColor=#2f8f55;fontColor=#2f8f55;" vertex="1" parent="1"><mxGeometry x="830" y="362" width="380" height="712" as="geometry"/></mxCell><mxCell id="c10" value="Power on (slide switch)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#e8eeff;strokeColor=#3d5bd9;" vertex="1" parent="1"><mxGeometry x="105" y="156" width="230" height="36" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b style='font-size:13.5px'&gt;setup()&lt;/b&gt;&lt;br&gt;Serial, CAST_BUTTON pull-up, RGB LED PWM&lt;br&gt;Find the IMU at 0x68 / 0x69, read WHO_AM_I&lt;br&gt;Set 100 Hz, ±8 g, ±2000 °/s, 45 Hz low-pass&lt;br&gt;Measure gyro offset (wand still, up to 3 s)&lt;br&gt;Start BLE, advertise &quot;SpellWand&quot;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eeff;strokeColor=#3d5bd9;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="50" y="212" width="340" height="124" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="&lt;b style='font-size:13.5px'&gt;Read the IMU (new reading every 10 ms)&lt;/b&gt;&lt;br&gt;convert to m/s² and rad/s, subtract gyro offset;&lt;br&gt;while IDLE, keep re-measuring the offset" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eeff;strokeColor=#3d5bd9;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="50" y="402" width="340" height="70" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c11" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="&lt;b style='font-size:13.5px'&gt;If CASTING: send MOTION_SAMPLE&lt;/b&gt;&lt;br&gt;index, time, accel, gyro (19 bytes)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eeff;strokeColor=#3d5bd9;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="50" y="488" width="340" height="52" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;b style='font-size:13.5px'&gt;Handle commands from the Mac&lt;/b&gt;&lt;br&gt;START / STOP_RECORDING, GESTURE_RESULT,&lt;br&gt;EXECUTE_ACTION (replies ACTION_COMPLETE)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eeff;strokeColor=#3d5bd9;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="50" y="560" width="340" height="70" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="&lt;b style='font-size:13.5px'&gt;Read CAST_BUTTON (debounced 30 ms)&lt;/b&gt;&lt;br&gt;pressed in IDLE: CAST_START, now CASTING&lt;br&gt;released: CAST_END, now INFLIGHT (amber)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eeff;strokeColor=#3d5bd9;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="50" y="648" width="340" height="70" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b style='font-size:13.5px'&gt;tick(): time limits&lt;/b&gt;&lt;br&gt;cast 3 s / recording 5 s: CAST_END&lt;br&gt;no GESTURE_RESULT within 2 s: magenta flashes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eeff;strokeColor=#3d5bd9;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="50" y="736" width="340" height="70" as="geometry"/></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b style='font-size:13.5px'&gt;Update STATUS_LED and action LED&lt;/b&gt;&lt;br&gt;state colour, spell colour, or flashes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e8eeff;strokeColor=#3d5bd9;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="50" y="824" width="340" height="52" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c23" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="220" y="898"/><mxPoint x="40" y="898"/><mxPoint x="40" y="437.0"/></Array></mxGeometry></mxCell><mxCell id="c26" value="back to the top" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11.5;fontColor=#5b6070;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="56" y="906" width="160" height="20" as="geometry"/></mxCell><mxCell id="c27" value="States IDLE / CASTING / INFLIGHT in detail: wand_states.svg" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#5b6070;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="30" y="980" width="420" height="20" as="geometry"/></mxCell><mxCell id="c28" value="python3 app.py   (or --simulate)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fontSize=13;fillColor=#e6f5ec;strokeColor=#2f8f55;" vertex="1" parent="1"><mxGeometry x="875" y="156" width="290" height="36" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b style='font-size:13.5px'&gt;Startup&lt;/b&gt;&lt;br&gt;Load config.json: threshold, gestures, colours&lt;br&gt;Load samples from data/, fit the classifier&lt;br&gt;Connect: BLE Manager (Bleak) or simulated wand&lt;br&gt;Open the SpellWand UI in the browser&lt;br&gt;(live updates through server-sent events)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f5ec;strokeColor=#2f8f55;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="850" y="212" width="340" height="124" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c28" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b style='font-size:13.5px'&gt;Decode the message (protocol.py)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f5ec;strokeColor=#2f8f55;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="850" y="402" width="340" height="40" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c29" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="&lt;b style='font-size:13.5px'&gt;Depending on the message&lt;/b&gt;&lt;br&gt;CAST_START: clear the buffer, UI shows Casting…&lt;br&gt;MOTION_SAMPLE: add to buffer, live charts&lt;br&gt;ACTION_COMPLETE: give to the Action Dispatcher&lt;br&gt;CAST_END: continue below" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f5ec;strokeColor=#2f8f55;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="850" y="460" width="340" height="106" as="geometry"/></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c31" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="Training&lt;br&gt;recording?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fontSize=12.5;fillColor=#e6f5ec;strokeColor=#2f8f55;" vertex="1" parent="1"><mxGeometry x="844" y="588" width="192" height="64" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;exitX=0.2647;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="Sample Recorder:&lt;br&gt;≥ 10 samples? save&lt;br&gt;CSV, retrain" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f5ec;strokeColor=#2f8f55;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=11.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="1078" y="584" width="122" height="74" as="geometry"/></mxCell><mxCell id="c38" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c35" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="&lt;b style='font-size:13.5px'&gt;Gesture Classifier (classifier.py)&lt;/b&gt;&lt;br&gt;GestureResult: label or UNKNOWN, distance,&lt;br&gt;nearest gesture (see classifier_pipeline.svg)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f5ec;strokeColor=#2f8f55;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="850" y="676" width="340" height="70" as="geometry"/></mxCell><mxCell id="c40" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.2647;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="c35" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b style='font-size:13.5px'&gt;Send GESTURE_RESULT&lt;/b&gt;&lt;br&gt;label + colour from config.json" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f5ec;strokeColor=#2f8f55;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="850" y="764" width="340" height="52" as="geometry"/></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f2430;strokeWidth=1.5;fontSize=11;fontColor=#5b6070;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c39" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="&lt;b style='font-size:13.5px'&gt;Show the result in the UI&lt;/b&gt;&lt;br&gt;label, distance, 3D trail, live charts" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e6f5ec;strokeColor=#2f8f55;align=left;verticalAlign=top;spacingLeft=12;spacingTop=2;fontSize=12.5;fontColor=#1f2430;" vertex="1" parent="1"><mxGeometry x="850" y="834" width="340" height="52" as="geometry"/></mxCell><mxCell id="c44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1f243